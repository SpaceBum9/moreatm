; moreatm.com — Cloudflare BIND import (Phase 1, DNS only)
; Import: Cloudflare → DNS → Import and Export → Upload
; Proxy remains OFF. Do not mix with leftover registrar A records.

$ORIGIN moreatm.com.
$TTL 3600

@    IN  A      185.199.108.153
@    IN  A      185.199.109.153
@    IN  A      185.199.110.153
@    IN  A      185.199.111.153
@    IN  AAAA   2606:50c0:8000::153
@    IN  AAAA   2606:50c0:8001::153
@    IN  AAAA   2606:50c0:8002::153
@    IN  AAAA   2606:50c0:8003::153
www  IN  CNAME  spacebum9.github.io.
@    IN  TXT    "v=spf1 -all"
@    IN  TXT    "MCT-ATM HOLD public=moreatm.com"
_dmarc IN TXT   "v=DMARC1; p=reject; adkim=s; aspf=s"
@    IN  CAA    0 issue "letsencrypt.org"
@    IN  CAA    0 issuewild ";"
